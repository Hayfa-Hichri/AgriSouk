<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.AgriSouk" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/green_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/green_100</item>
        <item name="colorOnPrimaryContainer">@color/green_900</item>
        <item name="colorSecondary">@color/amber_700</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/amber_100</item>
        <item name="colorOnSecondaryContainer">@color/brown_700</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorSurfaceContainerHighest">@color/surface_alt</item>
        <item name="colorOnSurface">@color/ink_900</item>
        <item name="colorOnSurfaceVariant">@color/ink_500</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/danger</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:statusBarColor">@color/green_900</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="materialButtonStyle">@style/Widget.AgriSouk.Button</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.AgriSouk.BottomSheet</item>
    </style>

    <style name="Widget.AgriSouk.BottomNavIndicator"
        parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/green_100</item>
    </style>

    <style name="ThemeOverlay.AgriSouk.BottomSheet"
        parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.AgriSouk.BottomSheet</item>
    </style>

    <style name="Widget.AgriSouk.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.AgriSouk.Sheet</item>
    </style>

    <style name="ShapeAppearance.AgriSouk.Sheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Widget.AgriSouk.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.AgriSouk.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/green_700</item>
        <item name="android:textColor">@color/green_800</item>
    </style>

    <style name="Widget.AgriSouk.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/green_700</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/green_700</item>
    </style>

    <style name="Widget.AgriSouk.TextInput.Dropdown"
        parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/green_700</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/green_700</item>
        <item name="endIconTint">@color/green_700</item>
    </style>

    <style name="TextAppearance.AgriSouk.ScreenTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/ink_900</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.AgriSouk.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/ink_900</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.AgriSouk.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/ink_700</item>
    </style>

    <style name="TextAppearance.AgriSouk.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/ink_500</item>
    </style>

</resources>
