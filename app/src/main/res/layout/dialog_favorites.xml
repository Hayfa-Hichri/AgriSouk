<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/favorites_title"
        android:textAppearance="@style/TextAppearance.AgriSouk.SectionTitle"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvFavoritesSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/menu_favorites_sub"
        android:textColor="@color/ink_500"
        android:textSize="12sp" />

    <ListView
        android:id="@+id/listFavorites"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:maxHeight="420dp"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/tvFavoritesEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:text="@string/favorites_empty"
        android:textColor="@color/ink_500"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
